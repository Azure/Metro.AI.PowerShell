<?xml version="1.0" encoding="utf-8" ?>
<Configuration>
    <ViewDefinitions>
        <View>
            <Name>Metro.AI.Resource</Name>
            <ViewSelectedBy>
                <TypeName>Metro.AI.Resource</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Name</Label>
                        <Width>25</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Id</Label>
                        <Width>35</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Model</Label>
                        <Width>20</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Description</Label>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>name</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>id</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>
                                    if ($_.model) { return $_.model }
                                    if ($_.definition -and $_.definition.model) { return $_.definition.model }
                                    if ($_.versions -and $_.versions.latest -and $_.versions.latest.definition -and $_.versions.latest.definition.model) { return $_.versions.latest.definition.model }
                                    return ""
                                </ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>
                                    if ($_.description) { return $_.description }
                                    if ($_.definition -and $_.definition.description) { return $_.definition.description }
                                    if ($_.versions -and $_.versions.latest -and $_.versions.latest.definition -and $_.versions.latest.definition.description) { return $_.versions.latest.definition.description }
                                    return ""
                                </ScriptBlock>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
    </ViewDefinitions>
</Configuration>